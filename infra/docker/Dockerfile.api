# LUXOR9 API image. Build context is the repository root:
#   docker build -f infra/docker/Dockerfile.api -t luxor9-api .
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies first for better layer caching.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install .

EXPOSE 8000

# Run as a non-root user.
RUN useradd --create-home --uid 1000 luxor9
USER luxor9

CMD ["uvicorn", "luxor9.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
